# docker/Dockerfile.colmap
# COLMAP Service with OpenMVS and communication layer
ARG BASE_TAG=latest
FROM colmap/colmap:${BASE_TAG}
ENV DEBIAN_FRONTEND=noninteractive

# Install communication and OpenMVS dependencies
USER root

# Install base dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    python3-dev \
    curl \
    binutils \
    file \
    build-essential \
    cmake \
    git \
    tree \
    vim \
    libopencv-dev \
    libeigen3-dev \
    libcgal-dev \
    libboost-all-dev \
    libglew-dev \
    libglfw3-dev \
    libglu1-mesa-dev \
    freeglut3-dev \
    mesa-common-dev \
    libxi-dev \
    libxmu-dev \
    libblas-dev \
    liblapack-dev \
    libnanoflann-dev \
    libjxl-dev \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Try to install CUDA toolkit if available
RUN apt-get update && \
    (apt-get install -y --no-install-recommends nvidia-cuda-toolkit nvidia-cuda-dev || \
     echo "CUDA toolkit not available, will build CPU-only version") && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Build OpenMVS with adaptive CUDA support
WORKDIR /tmp
RUN git clone --depth 1 https://github.com/cdcseacave/VCG.git vcglib && \
    git clone --branch v2.1.0 --depth 1 https://github.com/cdcseacave/openMVS.git && \
    cd openMVS && \
    mkdir -p build && \
    cd build && \
    if command -v nvcc >/dev/null 2>&1; then \
        echo "Building OpenMVS with CUDA support"; \
        cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DVCG_ROOT=/tmp/vcglib \
            -DOpenMVS_USE_CUDA=ON \
            -DOpenMVS_USE_BREAKPAD=OFF \
            -DCUDA_ARCH_BIN="6.0 6.1 7.0 7.5 8.0 8.6" || \
        cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DVCG_ROOT=/tmp/vcglib \
            -DOpenMVS_USE_CUDA=OFF \
            -DOpenMVS_USE_BREAKPAD=OFF; \
    else \
        echo "Building OpenMVS with CPU-only support"; \
        cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DVCG_ROOT=/tmp/vcglib \
            -DOpenMVS_USE_CUDA=OFF \
            -DOpenMVS_USE_BREAKPAD=OFF; \
    fi && \
    make -j$(nproc) && \
    cp bin/* /usr/local/bin/ && \
    cd / && \
    rm -rf /tmp/vcglib /tmp/openMVS

# Create directories
RUN mkdir -p /app /workspace /socks /app/logs && \
    chmod 755 /workspace /socks /app/logs

# Create a venv and use it for all subsequent Python/Pip commands
RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Install minimal Python packages for communication
RUN python3 -m pip install --no-cache-dir --upgrade pip
COPY server/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt

# Copy communication layer
COPY server/main.py /app/
COPY server/exec_ops.py /app/
COPY server/file_ops.py /app/
COPY server/utils.py /app/
COPY server/meshwork_pb2.py /app/
COPY server/meshwork_pb2_grpc.py /app/
COPY server/healthcheck.py /usr/local/bin/healthcheck.py
COPY server/recon_colmap.sh /app/recon.sh

WORKDIR /app

# Set environment
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# GPU detection entrypoint
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/healthcheck.py /app/recon.sh

# Health check using unified gRPC ping
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
    CMD SERVICE_NAME=colmap SERVICE_PORT=50052 python3 /usr/local/bin/healthcheck.py || exit 1

# Expose gRPC port
EXPOSE 50052

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "main.py", "--service", "colmap", "--port", "50052"]