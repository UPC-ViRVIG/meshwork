# Optional client overrides. Without a .env file MeshWork talks to the services
# over loopback TCP on 127.0.0.1:50051-50053, which is what the containers
# publish by default. Uncomment and edit only to reach a remote server, or to
# use the Unix domain sockets in .runtime/socks/ instead (Linux only).
# See docs/CONFIGURATION.md.

#MESHWORK_BLENDER=127.0.0.1:50051
#MESHWORK_COLMAP=127.0.0.1:50052
#MESHWORK_ALICEVISION=127.0.0.1:50053
#MESHWORK_LOG_LEVEL=INFO
